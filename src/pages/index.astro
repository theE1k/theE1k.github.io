---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Jisen.</h1>
			<p>
				I'm a backend engineer moving into AI agent and AI application engineering, currently
				finishing an MSc in Data Science at Newcastle University. This is where I write about what
				I'm learning and building. More <a href="/about">about me</a>.
			</p>
			<h2 class="mono">Recent posts</h2>
			<PostList limit={10} />
			<p class="mono all"><a href="/blog">all posts →</a></p>
		</main>
		<Footer />
	</body>
</html>
<style>
	h2 {
		margin: 3rem 0 0.5rem;
		font-weight: 400;
		letter-spacing: 0;
	}
	.all {
		margin-top: 1.5rem;
	}
</style>
