---
import { getCollection, render } from 'astro:content';
import LockedPost from '../../components/LockedPost.astro';
import Timeline from '../../components/Timeline.astro';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const [open, locked] = await Promise.all([getCollection('blog'), getCollection('locked')]);
	return [
		...open.map((post) => ({ params: { slug: post.id }, props: { post } })),
		...locked
			.filter((post) => post.data.section === 'blog')
			.map((post) => ({ params: { slug: post.id }, props: { locked: post } })),
	];
}

const { post, locked } = Astro.props;
const { Content } = post ? await render(post) : {};
---

{
	post && Content && (
		<BlogPost {...post.data}>
			{post.data.timeline && <Timeline items={post.data.timeline} />}
			<Content />
		</BlogPost>
	)
}
{
	locked && (
		<BlogPost
			title={locked.data.title}
			description={locked.data.description}
			pubDate={locked.data.pubDate}
			tags={locked.data.tags}
		>
			<LockedPost salt={locked.data.salt} iv={locked.data.iv} data={locked.data.data} />
		</BlogPost>
	)
}
