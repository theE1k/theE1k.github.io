---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const entries = (await getCollection('reading')).sort(
	(a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);
const groups = [
	{ status: 'reading', heading: 'Reading now' },
	{ status: 'finished', heading: 'Finished' },
	{ status: 'queued', heading: 'Want to read' },
]
	.map((group) => ({ ...group, entries: entries.filter((entry) => entry.data.status === group.status) }))
	.filter((group) => group.entries.length > 0);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Reading · ${SITE_TITLE}`} description="Books and articles I am reading or have read." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Reading</h1>
			<p class="muted intro">Books and articles I am reading or have read.</p>
			{groups.length === 0 && <p class="muted">Nothing here yet.</p>}
			{
				groups.map((group) => (
					<section>
						<h2>{group.heading}</h2>
						<ul>
							{group.entries.map((entry) => {
								const hasNotes = (entry.body ?? '').trim().length > 0;
								return (
									<li>
										<div class="text">
											<span class="title">
												{hasNotes ? <a href={`/reading/${entry.id}/`}>{entry.data.title}</a> : entry.data.title}
											</span>
											{entry.data.author && <span class="muted author">{entry.data.author}</span>}
											{entry.data.comment && <span class="comment">{entry.data.comment}</span>}
										</div>
										<div class="meta muted">
											{entry.data.date && <FormattedDate date={entry.data.date} />}
											{entry.data.link && (
												<a href={entry.data.link} target="_blank" rel="noopener">
													Source ↗
												</a>
											)}
											{hasNotes && <a href={`/reading/${entry.id}/`}>Notes</a>}
										</div>
									</li>
								);
							})}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin: -0.5rem 0 2.5rem;
	}
	h2 {
		margin: 2.5rem 0 0.9rem;
		font-size: 1.15rem;
		letter-spacing: -0.01em;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		margin: 0 0 0.6rem;
		padding: 1.1rem 1.5rem;
		border-radius: 20px;
		background: var(--surface);
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.title {
		color: var(--heading);
		font-size: 1.05rem;
		font-weight: 500;
	}
	.author,
	.comment {
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.comment {
		margin-top: 0.3rem;
	}
	.meta {
		display: flex;
		flex-shrink: 0;
		gap: 1rem;
		font-size: 0.875rem;
	}
	.meta a {
		color: var(--muted);
	}
	@media (max-width: 720px) {
		li {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
