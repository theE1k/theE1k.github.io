---
import { getAllPosts, getAllWriting } from '../posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	limit?: number;
	// Only posts filed under this topic id
	tag?: string;
	// Include journal entries and reading notes, not only posts
	everything?: boolean;
}

const { limit, tag, everything = false } = Astro.props;
const source = everything
	? await getAllWriting()
	: (await getAllPosts()).map((post) => ({ ...post, kind: undefined as string | undefined }));
const posts = source.filter((post) => !tag || post.tags.includes(tag)).slice(0, limit);
---

<ul>
	{
		posts.map((post) => (
			<li>
				<a href={post.url}>
					<span class="text">
						<span class="title">
							{post.title}
							{post.locked && (
								<svg viewBox="0 0 24 24" width="14" height="14" role="img" aria-label="Password-protected">
									<rect x="5" y="11" width="14" height="9" rx="2" />
									<path d="M8 11V8a4 4 0 0 1 8 0v3" />
								</svg>
							)}
						</span>
						<span class="description">{post.description}</span>
					</span>
					<span class="date">
						{post.kind && <span class="kind">{post.kind}</span>}
						{post.pubDate && <FormattedDate date={post.pubDate} />}
					</span>
				</a>
			</li>
		))
	}
</ul>
<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		margin: 0 0 0.6rem;
	}
	a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.15rem 1.5rem;
		border-radius: 20px;
		background: var(--surface);
		text-decoration: none;
		transition: background 0.15s;
	}
	a:hover {
		background: var(--surface-2);
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.title svg {
		margin-left: 0.3rem;
		fill: none;
		stroke: var(--muted);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.title {
		color: var(--heading);
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.description {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.kind {
		margin-right: 0.75rem;
		padding: 0.1rem 0.6rem;
		border-radius: 999px;
		background: var(--surface-2);
		font-size: 0.75rem;
	}
	.date {
		flex-shrink: 0;
		color: var(--muted);
		font-size: 0.875rem;
	}
</style>
