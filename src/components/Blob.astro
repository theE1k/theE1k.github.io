---
// The site mascot: a soft blob with two upright eyes. Used as the logo, as topic
// avatars in different shapes and colours, and large as decoration.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
	shape?: 'squircle' | 'pebble' | 'triangle' | 'diamond' | 'pill';
	color?: string;
	eyeColor?: string;
	outline?: boolean;
	// Eyes follow the cursor
	track?: boolean;
}

const {
	shape = 'squircle',
	color = 'var(--heading)',
	eyeColor = 'var(--bg)',
	outline = false,
	track = false,
	...rest
} = Astro.props;

// Vertical position of the eyes for each body shape
const eyeY = { squircle: 28, pebble: 26, triangle: 46, diamond: 36, pill: 36 }[shape];
const body = outline
	? { fill: 'none', stroke: 'currentColor', 'vector-effect': 'non-scaling-stroke' }
	: { fill: color, stroke: color };
const eye = outline
	? { fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'vector-effect': 'non-scaling-stroke' }
	: { fill: eyeColor };
---

<svg viewBox="0 0 100 100" aria-hidden="true" data-blob-track={track ? '' : undefined} {...rest}>
	{shape === 'squircle' && <rect x="4" y="4" width="92" height="92" rx="34" {...body} stroke-width={outline ? 2 : 0} />}
	{
		shape === 'pebble' && (
			<path
				d="M52 4c27 0 44 17 44 43 0 30-19 49-47 49S4 78 4 49C4 21 24 4 52 4z"
				{...body}
				stroke-width={outline ? 2 : 0}
			/>
		)
	}
	{
		shape === 'triangle' && (
			<path d="M50 20 84 80H16z" {...body} stroke-width={outline ? 2 : 24} stroke-linejoin="round" />
		)
	}
	{
		shape === 'diamond' && (
			<rect
				x="17"
				y="17"
				width="66"
				height="66"
				rx="18"
				transform="rotate(45 50 50)"
				{...body}
				stroke-width={outline ? 2 : 0}
			/>
		)
	}
	{shape === 'pill' && <rect x="4" y="20" width="92" height="60" rx="30" {...body} stroke-width={outline ? 2 : 0} />}
	<g class="eyes">
		<rect x="38" y={eyeY} width="9" height="24" rx="4.5" {...eye} />
		<rect x="55" y={eyeY} width="9" height="24" rx="4.5" {...eye} />
	</g>
</svg>

<style>
	svg {
		display: block;
		overflow: visible;
	}
	.eyes {
		transform: translate(calc(var(--ex, 0) * 1px), calc(var(--ey, 0) * 1px));
		transition: transform 0.12s ease-out;
	}
	.eyes rect {
		transform-box: fill-box;
		transform-origin: center;
		animation: blink 5.5s infinite;
	}
	@keyframes blink {
		0%,
		94%,
		100% {
			transform: scaleY(1);
		}
		97% {
			transform: scaleY(0.1);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.eyes rect {
			animation: none;
		}
	}
</style>
