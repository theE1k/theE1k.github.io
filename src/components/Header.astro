---
import { SITE_TITLE } from '../consts';
import Blob from './Blob.astro';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<a class="site-title" href="/">
		<Blob track width="26" height="26" />
		{SITE_TITLE}
	</a>
	<nav>
		<HeaderLink href="/blog">Writing</HeaderLink>
		<HeaderLink href="/journal">Journal</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
		<a href="/rss.xml">RSS</a>
	</nav>
	<div class="actions">
		<button id="theme-toggle" type="button" aria-label="Toggle dark mode">
			<svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
			</svg>
			<svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
			</svg>
		</button>
		<a class="btn btn-primary" href="https://github.com/theE1k" target="_blank" rel="noopener">GitHub</a>
	</div>
</header>
<script is:inline>
	document.getElementById('theme-toggle').addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
	// Mascot eyes follow the cursor
	window.addEventListener('pointermove', (event) => {
		document.querySelectorAll('[data-blob-track]').forEach((blob) => {
			const box = blob.getBoundingClientRect();
			const dx = event.clientX - (box.left + box.width / 2);
			const dy = event.clientY - (box.top + box.height / 2);
			const reach = Math.max(1, Math.hypot(dx, dy) / 120);
			blob.style.setProperty('--ex', Math.max(-6, Math.min(6, dx / 20 / reach)).toFixed(1));
			blob.style.setProperty('--ey', Math.max(-5, Math.min(5, dy / 20 / reach)).toFixed(1));
		});
	});
</script>
<style>
	header {
		display: flex;
		align-items: center;
		gap: 2.5rem;
		height: 64px;
		border-bottom: 1px solid var(--border);
		font-size: 0.9rem;
	}
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--heading);
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		margin-right: auto;
	}
	nav a {
		color: var(--heading);
		text-decoration: none;
		opacity: 0.75;
		transition: opacity 0.15s;
	}
	nav a:hover,
	nav a.active {
		opacity: 1;
	}
	nav a.active {
		font-weight: 500;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.actions .btn {
		padding: 0.5rem 1rem;
		font-size: 0.9rem;
	}
	button {
		display: flex;
		padding: 0.6rem;
		border: none;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--heading);
		cursor: pointer;
	}
	button svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.moon,
	:global([data-theme='dark']) .sun {
		display: none;
	}
	:global([data-theme='dark']) .moon {
		display: block;
	}
	@media (max-width: 720px) {
		header {
			gap: 1.25rem;
		}
		nav {
			gap: 1.1rem;
		}
		.actions .btn {
			display: none;
		}
	}
</style>
