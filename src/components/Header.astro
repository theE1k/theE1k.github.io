---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<a class="site-title" href="/">{SITE_TITLE}</a>
	<nav>
		<HeaderLink href="/blog">blog</HeaderLink>
		<HeaderLink href="/about">about</HeaderLink>
		<a href="https://github.com/theE1k" target="_blank" rel="noopener">github</a>
		<button id="theme-toggle" type="button" aria-label="Toggle dark mode">
			<svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
			</svg>
			<svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
			</svg>
		</button>
	</nav>
</header>
<script is:inline>
	document.getElementById('theme-toggle').addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
</script>
<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.5rem 0 1rem;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	.site-title {
		color: var(--heading);
		font-weight: 700;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover,
	nav a.active {
		color: var(--heading);
	}
	button {
		display: flex;
		padding: 0.25rem;
		border: none;
		background: none;
		color: var(--muted);
		cursor: pointer;
	}
	button:hover {
		color: var(--heading);
	}
	svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.moon,
	:global([data-theme='dark']) .sun {
		display: none;
	}
	:global([data-theme='dark']) .moon {
		display: block;
	}
</style>
