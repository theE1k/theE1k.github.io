---
import { SECTIONS, SITE_TITLE, TOPICS } from '../consts';
import Blob from './Blob.astro';
import HeaderLink from './HeaderLink.astro';

const menu = [
	...TOPICS.map((topic) => ({ ...topic, href: `/topics/${topic.id}/` })),
	...SECTIONS,
];
const inTopics = /^\/(topics|blog|reading|journal)(\/|$)/.test(Astro.url.pathname);
---

<header>
	<a class="site-title" href="/">
		<Blob track width="26" height="26" />
		{SITE_TITLE}
	</a>
	<nav>
		<div class="menu">
			<a href="/topics" class:list={['trigger', { active: inTopics }]} aria-haspopup="true">
				Topics
				<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4"></path></svg>
			</a>
			<div class="panel">
				{
					menu.map((item) => (
						<a href={item.href}>
							<Blob
								shape={item.shape}
								color={item.color}
								eyeColor={item.color.startsWith('var') ? 'var(--bg)' : '#fff'}
								width="30"
								height="30"
							/>
							<span>
								<strong>{item.name}</strong>
								<small>{item.text}</small>
							</span>
						</a>
					))
				}
			</div>
		</div>
		<HeaderLink href="/about">About</HeaderLink>
	</nav>
	<div class="actions">
		<button id="theme-toggle" type="button" aria-label="Toggle dark mode">
			<svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
			</svg>
			<svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
			</svg>
		</button>
		<a class="btn btn-primary" href="https://github.com/theE1k" target="_blank" rel="noopener">GitHub</a>
	</div>
</header>
<script is:inline>
	document.getElementById('theme-toggle').addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
	// Mascot eyes follow the cursor
	window.addEventListener('pointermove', (event) => {
		document.querySelectorAll('[data-blob-track]').forEach((blob) => {
			const box = blob.getBoundingClientRect();
			const dx = event.clientX - (box.left + box.width / 2);
			const dy = event.clientY - (box.top + box.height / 2);
			const reach = Math.max(1, Math.hypot(dx, dy) / 120);
			blob.style.setProperty('--ex', Math.max(-6, Math.min(6, dx / 20 / reach)).toFixed(1));
			blob.style.setProperty('--ey', Math.max(-5, Math.min(5, dy / 20 / reach)).toFixed(1));
		});
	});
</script>
<style>
	header {
		position: relative;
		display: flex;
		align-items: center;
		gap: 2.5rem;
		height: 64px;
		border-bottom: 1px solid var(--border);
		font-size: 0.9rem;
	}
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--heading);
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		margin-right: auto;
	}
	nav a {
		color: var(--heading);
		text-decoration: none;
		opacity: 0.75;
		transition: opacity 0.15s;
	}
	nav a:hover,
	nav a.active {
		opacity: 1;
	}
	nav a.active {
		font-weight: 500;
	}
	/* Topics menu: opens on hover and on keyboard or touch focus */
	.menu {
		position: relative;
	}
	.trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 1.2rem 0;
	}
	.trigger svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 0.15s;
	}
	.menu:hover .trigger svg,
	.menu:focus-within .trigger svg {
		transform: rotate(180deg);
	}
	.panel {
		position: absolute;
		top: 100%;
		left: -1rem;
		z-index: 20;
		display: grid;
		grid-template-columns: repeat(2, 260px);
		gap: 0.25rem;
		padding: 0.6rem;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--bg);
		box-shadow: 0 16px 40px rgb(0 0 0 / 0.12);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-4px);
		transition:
			opacity 0.15s,
			transform 0.15s,
			visibility 0.15s;
	}
	.menu:hover .panel,
	.menu:focus-within .panel {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.panel a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 0.75rem;
		border-radius: 12px;
		opacity: 1;
	}
	.panel a:hover {
		background: var(--surface);
	}
	.panel a > :global(svg) {
		flex-shrink: 0;
	}
	.panel span {
		display: grid;
		min-width: 0;
	}
	.panel strong {
		font-weight: 500;
	}
	.panel small {
		overflow: hidden;
		color: var(--muted);
		font-size: 0.8rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.actions .btn {
		padding: 0.5rem 1rem;
		font-size: 0.9rem;
	}
	button {
		display: flex;
		padding: 0.6rem;
		border: none;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--heading);
		cursor: pointer;
	}
	button svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.moon,
	:global([data-theme='dark']) .sun {
		display: none;
	}
	:global([data-theme='dark']) .moon {
		display: block;
	}
	@media (max-width: 720px) {
		header {
			gap: 1.25rem;
		}
		nav {
			gap: 1.1rem;
		}
		.menu {
			position: static;
		}
		.panel {
			left: 1rem;
			right: 1rem;
			top: 64px;
			grid-template-columns: 1fr;
		}
		.actions .btn {
			display: none;
		}
	}
</style>
