---
const today = new Date();
---

<footer class="mono">
	<span>&copy; {today.getFullYear()} Jisen Lei</span>
	<a href="/rss.xml">rss</a>
</footer>
<style>
	footer {
		display: flex;
		justify-content: space-between;
		padding: 1.5rem 0 3rem;
		border-top: 1px solid var(--border);
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--heading);
	}
</style>
